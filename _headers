# Fonts and libraries have the version in their filename, so they can be cached forever
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Images keep their names when replaced, so cache for a week and refresh in the background
/projects/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
